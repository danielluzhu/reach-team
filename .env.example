# Copy to .env and fill in. Bun loads .env automatically at startup.
#
# .env is gitignored and .env.example is not, so never put a real secret here.
# Note that being gitignored also means `git status` will not warn you before
# you overwrite .env — check for it first.

# Public address(es) the app is reached on. Required when a reverse proxy sits
# in front and doesn't preserve the Host header, otherwise every save is
# rejected as cross-origin. Comma-separated for more than one.
TRUSTED_ORIGINS=https://crm.example.com

# Always invited on every tour event, on top of the tour guide. Comma-separated.
CALENDAR_STANDING_GUESTS=office@example.com

# Booking a calendar event for each new tour. Both must be set or the feature
# stays off — tours are still queued, nothing is sent. See
# google-apps-script/tour-calendar.gs for how to get these.
CALENDAR_WEBHOOK_URL=https://script.google.com/macros/s/PASTE_DEPLOYMENT_ID/exec
CALENDAR_WEBHOOK_SECRET=paste-the-same-secret-as-in-the-apps-script
